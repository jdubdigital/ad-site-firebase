{
  "name": "ad-archive-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.7.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "firebase": "^12.14.0"
  }
}

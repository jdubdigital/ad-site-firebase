rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyLikeCountChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['likes', 'updatedAt'])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && (
          request.resource.data.likes == resource.data.likes + 1 ||
          request.resource.data.likes == resource.data.likes - 1
        )
        && request.resource.data.updatedAt == request.time;
    }

    function ownerUidUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function validOwnerAdUpdate() {
      return ownerUidUnchanged()
        && request.resource.data.likes == resource.data.likes;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.likes == 0;
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid && validOwnerAdUpdate()) ||
        onlyLikeCountChanged()
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update, delete: if owns(uid);
    }

    match /userState/{uid} {
      allow read, create, update, delete: if owns(uid);
    }
  }
}

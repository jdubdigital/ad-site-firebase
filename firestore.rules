rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyLikeCountChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['likes', 'updatedAt'])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && (
          request.resource.data.likes == resource.data.likes + 1 ||
          request.resource.data.likes == resource.data.likes - 1
        )
        && request.resource.data.updatedAt == request.time;
    }

    function ownerUidUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function validOwnerAdUpdate() {
      return ownerUidUnchanged()
        && request.resource.data.likes == resource.data.likes;
    }

    function validUsernameSlug(slug) {
      return slug is string
        && slug.matches('^[a-z0-9][a-z0-9-]{1,46}[a-z0-9]$');
    }

    function profileHasOwnedUsername(uid) {
      return validUsernameSlug(request.resource.data.userSlug)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.userSlug)).data.ownerUid == uid;
    }

    function profileUsernameUnchanged() {
      return request.resource.data.userSlug == resource.data.userSlug
        && request.resource.data.username == resource.data.username;
    }

    function profileHasNoEmail() {
      return !request.resource.data.keys().hasAny(['email']);
    }

    function onlyRemovesLegacyEmail() {
      return resource.data.keys().hasAny(['email'])
        && !request.resource.data.keys().hasAny(['email'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.likes == 0;
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid && validOwnerAdUpdate()) ||
        onlyLikeCountChanged()
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.ownerUid == request.auth.uid
        && profileHasNoEmail()
        && profileHasOwnedUsername(uid);
      allow update: if owns(uid)
        && (
          onlyRemovesLegacyEmail() ||
          (
            request.resource.data.ownerUid == request.auth.uid
            && profileHasNoEmail()
            && profileUsernameUnchanged()
            && profileHasOwnedUsername(uid)
          )
        );
      allow delete: if owns(uid);
    }

    match /usernames/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && validUsernameSlug(slug)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.userSlug == slug;
      allow update: if signedIn()
        && validUsernameSlug(slug)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.userSlug == slug;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /displayNames/{key} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /userState/{uid} {
      allow read, create, update, delete: if owns(uid);
    }
  }
}
